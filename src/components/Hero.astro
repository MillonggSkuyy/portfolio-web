---
---

<section class="py-16 sm:py-24 border-b border-slate-800/80">
  <div class="flex flex-col-reverse md:flex-row items-center justify-between gap-8 md:gap-12">
    
    <!-- Kolom Teks Perkenalan -->
    <div class="flex-1 text-center md:text-left">
      <div class="inline-block px-3 py-1 mb-4 text-xs font-mono font-medium tracking-wider text-teal-400 bg-teal-950/60 border border-teal-800/50 rounded-full w-fit mx-auto md:mx-0">
        Fresh Graduated
      </div>
      
      <h1 class="text-4xl sm:text-6xl font-bold tracking-tight text-slate-100 mb-4">
        Halo, Saya Kamil Mahsyar Akbar
      </h1>
      
      <p class="text-lg sm:text-xl text-slate-400 max-w-2xl mb-8 leading-relaxed mx-auto md:mx-0">
        Berfokus pada perancangan UI/UX yang intuitif di Figma, pengembangan antarmuka web Front-End yang responsif, serta pembuatan purwarupa sistem keamanan pintar berbasis Internet of Things (IoT).
      </p>
      
      <div class="flex flex-wrap justify-center md:justify-start gap-4">
        <a
          href="/resume.pdf"
          target="_blank"
          class="px-6 py-3 bg-teal-500 hover:bg-teal-400 text-slate-950 font-semibold rounded-lg transition-colors"
        >
          Download CV (PDF)
        </a>
        <a
          href="#projects"
          class="px-6 py-3 border border-slate-700 hover:border-slate-500 text-slate-300 font-medium rounded-lg transition-colors"
        >
          Lihat Proyek
        </a>
      </div>
    </div>

    <!-- Kolom Foto Profil -->
    <div class="relative group shrink-0">
      <div class="absolute -inset-1 bg-gradient-to-r from-teal-500 to-cyan-500 rounded-full blur opacity-40 group-hover:opacity-75 transition duration-300"></div>
      <img
        src="/profile.jpg"
        alt="Kamil Mahsyar Akbar"
        class="relative w-48 h-48 sm:w-60 sm:h-60 rounded-full object-cover border-2 border-slate-700 shadow-2xl"
      />
    </div>

  </div>
</section>