      <a 
        href="https://www.linkedin.com/in/kamil-mahsyar-akbar-346383319/" 
        target="_blank" 
        rel="noopener noreferrer"
        class="hover:text-teal-400 transition-colors"
      >
        LinkedIn
      </a>
      <a 
        href="mailto:kamilmahsyarakbar@gmail.com" 
        class="hover:text-teal-400 transition-colors"
      >
        Email
      </a>
    </div>
  </div>
</footer>